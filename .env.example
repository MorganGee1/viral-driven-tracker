# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the site lives
NEXT_PUBLIC_SITE_URL=https://tracker.viraldrivenmedia.com

# --- Only once Amazon has approved Ads API access (see README) ---
# Login with Amazon security profile
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Any long random string. Encrypts the stored Amazon token. Never change it once a brand is connected.
AMAZON_TOKEN_KEY=
# Supabase service_role key. Server only. Used to store the Amazon connection and for the nightly sync.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel sends it when it runs the nightly sync.
CRON_SECRET=
