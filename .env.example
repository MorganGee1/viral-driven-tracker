# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the site lives
NEXT_PUBLIC_SITE_URL=https://app.viraldrivenmedia.com

# --- Only once Amazon has approved Ads API access (see README) ---
# Login with Amazon app approved for your own brand (the "own-brand app"). MyCompanion connects through this one.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Login with Amazon app approved for connecting clients' accounts (the "partner app"). Every other brand connects through this one.
AMAZON_PARTNER_CLIENT_ID=
AMAZON_PARTNER_CLIENT_SECRET=
# Any long random string. Encrypts the stored Amazon token. Never change it once a brand is connected.
AMAZON_TOKEN_KEY=
# Supabase service_role key. Server only. Used to store the Amazon connection and for the nightly sync.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel sends it when it runs the nightly sync.
CRON_SECRET=

# Deep links (optional). With a LinkTwin API key set, the team can switch deep links on per product:
# each tracked link then also gets a LinkTwin link that opens the Amazon app on a phone.
# LINKTWIN_API_KEY=
# A branded domain already added in LinkTwin, if you do not want links on linktw.in:
# LINKTWIN_DOMAIN=
